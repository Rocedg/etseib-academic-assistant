# Configuración de la prueba. Los modelos son CANDIDATOS, no decisiones del equipo.
# Si un nombre no existe en ollama.com/library, el script prueba el siguiente de la lista.
OLLAMA_VERSION=0.34.4                          # versión fijada en la comparativa; si falla, se baja la última
MODELS_4B="qwen3.5:4b gemma4:e4b qwen3:4b"    # opción 1 (todo) y opción 2 (diagnosticador y supervisor)
AGENT_MODELS="qwen3.5:9b gemma4:12b qwen3:8b" # opción 2 (agente que responde con citas)
EMBEDDING_MODEL="qwen3-embedding:0.6b"              # opción 2 (embeddings)
MIN_RAM_OPTION2_GB=12                          # memoria libre mínima para intentar la opción 2
